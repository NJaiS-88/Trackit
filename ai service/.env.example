# Copy to .env (same folder) and fill in. Do not wrap values in quotes.

# Google AI Studio API key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TEMPERATURE=0.2
# GEMINI_TIMEOUT_SECONDS=60

# OpenRouter API key for ticket routing (which department should handle a ticket): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=typesafe/jev-router
# OPENROUTER_TEMPERATURE=0
# OPENROUTER_TIMEOUT_SECONDS=30

# Shared secret the Trackit backend sends in the X-Service-Token header. Leave empty to disable (local dev only).
SERVICE_TOKEN=

# Comma-separated browser origins allowed to call the service directly. Usually empty: the backend calls it.
CORS_ALLOWED_ORIGINS=
