# Copy to .env (same folder) and fill in real values. Do not wrap values in quotes.

# MongoDB connection string, e.g. from MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/

# Base64-encoded key of at least 256 bits. Generate with: openssl rand -base64 32
JWT_SECRET=

# Upstash Redis TLS connection string (Console -> your database -> Connect -> "Redis URL", not the REST URL/token)
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Comma-separated exact frontend origins allowed to send cookies (no "*")
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local development over plain http: use SameSite=Lax cookies without the Secure flag.
# Leave unset (true) in production.
COOKIE_SECURE=false

# First admin, created at startup only if no active admin exists (sign-ups need an admin to approve them)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Administrator

# Optional overrides
# ACCESS_TOKEN_TTL=10m
# REFRESH_TOKEN_TTL=7d
# REDIS_KEY_PREFIX=trackit:
# MONGO_DATABASE=trackit
# PORT=8081
# API_DOCS_ENABLED=true
